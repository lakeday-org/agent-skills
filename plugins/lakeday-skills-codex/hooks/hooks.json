{
  "description": "Lakeday ALWAYS knowledge capture: sessions, decisions, outcomes, provenance, and Tardigrade-style context injection.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/lakeday-hook.mjs\"",
            "timeout": 20,
            "statusMessage": "Loading Lakeday knowledge"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/lakeday-hook.mjs\"",
            "timeout": 20,
            "statusMessage": "Projecting Lakeday session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__lakeday.*__.*|Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/lakeday-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/lakeday-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording Lakeday session"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/lakeday-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/lakeday-hook.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
